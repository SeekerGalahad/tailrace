# Allow esbuild install scripts (Vite needs its native binary).
enable-pre-post-scripts=true
# Disable pnpm's pre-run dependency-state check (without this, node_modules installed
# by a different pnpm version is judged stale -> purge rejected without a TTY ->
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY; proven necessary on this machine).
verify-deps-before-run=false
